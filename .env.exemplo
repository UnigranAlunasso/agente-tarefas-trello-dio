# Modelo de configuração do agente (somente valores de exemplo).
# Copie para .env e preencha APENAS no seu computador.
# NUNCA publique o arquivo .env, chaves ou tokens.

# Google Gemini via Google AI Studio
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.5-flash-lite

# Trello: chave e token de acesso com permissões read/write
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# Quadro de tarefas: o ID é opcional se o nome for único na sua conta
TRELLO_BOARD_NAME=DIO
TRELLO_BOARD_ID=

# Data de vencimento no fuso local
APP_TIMEZONE=America/Campo_Grande
